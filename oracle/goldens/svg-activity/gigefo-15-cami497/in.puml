@startuml
skinparam reverseColor RBG
start
:foo1;
:foo2;<<#red>>
while (data available?) <<#AliceBlue>>
  :read data;
  :generate diagrams;
endwhile
if (graphviz installed?) then (yes) <<#blue>>
  :process all\ndiagrams;
else (no)
  :process only
  __sequence__ and __activity__ diagrams;
endif
repeat <<#DarkCyan>>
  :read data;
  :generate diagrams;
repeat while (more data?)
stop
@enduml