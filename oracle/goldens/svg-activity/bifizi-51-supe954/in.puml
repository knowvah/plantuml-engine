@startuml
skinparam shadowing false
start
if ()
    :dummy; <<#PaleGreen>>
        note left
            dummy text
        end note
    :dummy; <<#PaleGreen>>
        note left
            dummy text
        end note
    if () then ([dummy text])
    :dummy; <<#PaleGreen>>
        note:dummy text
    :dummy; <<#PaleGreen>>
    else ([dummy text])
        note right
             dummy text
        end note
        if () then ( )
            :dummy; <<#PaleGreen>>
            end;
        else ([dummy\ntext])
            :dummy; <<#PaleGreen>>
            end;    
        endif    
    endif
else ([dummy text])
    :dummy; <<#PaleGreen>>
endif
stop
@enduml