diff --git a/src/diagrams/activity/activity-draw-extent.ts b/src/diagrams/activity/activity-draw-extent.ts
new file mode 100644
index 000000000..6b105215c
--- /dev/null
+++ b/src/diagrams/activity/activity-draw-extent.ts
@@ -0,0 +1,42 @@
+/**
+ * activity-draw-extent -- the `SvgGraphics#ensureVisible` extent of every
+ * `TextBlock` an activity render draws into a throwaway graphic.
+ *
+ * Upstream draws the whole document into ONE `SvgGraphics`, whose root
+ * `width`/`height` is the largest point any element asked
+ * `ensureVisible` to keep visible (`SvgGraphics.java:129-136`) -- which is
+ * not always the layout's ink box: an `SEG_ARCTO` segment asks for
+ * `(endX + rx, endY + ry)` (`SvgGraphics.java:854`), past the path's own
+ * `UPath` minmax (`UPath.java:86-87`, the end point alone). This port
+ * splices each text block's markup from a throwaway graphic
+ * (`activity-text-sheet.ts#drawActivityTextBlock`), so that graphic's
+ * extent would be lost; the render's sink keeps the maximum. The sink rides
+ * on the theme the way `activity-string-bounder.ts`'s measurer does, and a
+ * theme without one (layout-time callers) simply records nothing.
+ *
+ * @see ~/git/plantuml/src/main/java/net/sourceforge/plantuml/klimt/drawing/svg/SvgGraphics.java:129-136,854
+ */
+import type { Theme } from '../../core/theme.js';
+
+/** The running maximum of the throwaway graphics' `ensureVisible` extents. */
+export interface ActivityDrawExtent {
+  maxX: number;
+  maxY: number;
+}
+
+const EXTENT_KEY: unique symbol = Symbol('activity.drawExtent');
+
+type ThemeWithExtent = Theme & { readonly [EXTENT_KEY]?: ActivityDrawExtent };
+
+/** `theme` carrying `sink` as the render's draw-extent accumulator. */
+export function withActivityDrawExtent<T extends Theme>(theme: T, sink: ActivityDrawExtent): T {
+  return { ...theme, [EXTENT_KEY]: sink };
+}
+
+/** Raise the render's extent to `extent` (a no-op for a theme with no sink). */
+export function reportActivityDrawExtent(theme: Theme, extent: ActivityDrawExtent): void {
+  const sink = (theme as ThemeWithExtent)[EXTENT_KEY];
+  if (sink === undefined) return;
+  sink.maxX = Math.max(sink.maxX, extent.maxX);
+  sink.maxY = Math.max(sink.maxY, extent.maxY);
+}
