{
  "name": "@knowvah/plantuml-stdlib-aws",
  "version": "0.1.0",
  "description": "Vendored AWS Architecture Icons for PlantUML (awslib14) for plantuml-engine",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/knowvah/plantuml-engine.git",
    "directory": "packages/stdlib-aws"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "copy-assets": "node scripts/copy-assets.mjs",
    "prepack": "npm run copy-assets"
  },
  "files": [
    "generated",
    "assets",
    "licenses",
    "LICENSE",
    "LICENSE-CODE",
    "LICENSES.md",
    "README.md"
  ],
  "main": "./generated/index.js",
  "types": "./generated/index.d.ts",
  "exports": {
    ".": {
      "types": "./generated/index.d.ts",
      "import": "./generated/index.js"
    },
    "./awslib14.remote": {
      "types": "./generated/awslib14.remote.d.ts",
      "import": "./generated/awslib14.remote.js"
    },
    "./awslib.remote": {
      "types": "./generated/awslib.remote.d.ts",
      "import": "./generated/awslib.remote.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@knowvah/plantuml-engine": "^0.2.0"
  },
  "devDependencies": {
    "@knowvah/plantuml-engine": "file:../.."
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
