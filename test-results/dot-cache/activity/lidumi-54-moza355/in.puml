@startuml
!t="this is t1\nthis is t2\nthis is t3\n"

if (if?) then (<color blue>yes)
  :a a a a a;
->t;
else (<color blue>no)
  :b b b b b;
->t;
endif
fork
->t;
  :action 1;
->t;
fork again
->t;
  :action 2;
->t;
end merge
split
->t;
  :action 1;
->t;
split again
->t;
  :action 2;
->t;
end split
while (data available?)
  :read data;
  :generate diagrams;
->t;
endwhile (t)
:end;
repeat
  :read data;
  :generate diagrams;
->t;
repeat while (while) is (t)
stop
@enduml